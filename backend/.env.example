PORT=8080
APP_BASE=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Ollama / Local Models
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_MODEL=gemma4:e2b
AGENT_MODEL=gemma4:e2b

# Google Gemini Cloud Brain (optional, if using cloud fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
REASON_MODEL=gemini-3.8-flash

# Google Workspace OAuth (Google Login, Gmail API, Calendar API)
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# Get from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth (optional)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Atlas Campus Platform Security & Identity (Required for production)
# ATLAS_AUTH_MODE: 'development' allows local test personas; 'production' strictly enforces HMAC-SHA256 tokens
ATLAS_AUTH_MODE=development
# ATLAS_JWT_SECRET: Minimum 32-character secret shared with institutional Identity Provider (IdP)
ATLAS_JWT_SECRET=
ATLAS_JWT_ISSUER=atlas-auth-service
ATLAS_JWT_AUDIENCE=atlas-campus-platform
ENABLE_DEV_PERSONAS=true
